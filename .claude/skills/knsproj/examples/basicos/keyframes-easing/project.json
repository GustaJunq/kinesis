{
  "format": "knsproj",
  "formatVersion": 1,
  "generator": "knsproj skill examples",
  "meta": {"title": "Keyframes e easing"},
  "composition": {"width": 1080, "height": 1080, "fps": 30, "duration": 4, "background": "#101522"},
  "layers": [
    {
      "id": "overshoot",
      "type": "shape",
